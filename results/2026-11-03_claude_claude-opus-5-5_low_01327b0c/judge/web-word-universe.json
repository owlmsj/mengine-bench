 \"esperança\", \"felicidade\", \"ovo\", \"sílaba\", \"ternura\"], \"contato\": [], \"contentamento\": [\"compaixão\", \"felicidade\", \"pais\", \"prazer\"], \"conto\": [\"folha\", \"herança\", \"lar\", \"livro\", \"paixão\", \"palavra\", \"romance\", \"verso\"], \"conversa\": [\"fala\", \"felicidade\", \"grito\", \"silêncio\"], \"coração\": [\"advogado\", \"avô\", \"jantar\", \"joelho\", \"peito\", \"pulmão\", \"rosto\"], \"corpo\": [\"alma\", \"cabeça\", \"peixe\", \"pescoço\"], \"cozinha\": [\"capital\", \"esquina\", \"fígado\", \"janela\", \"pai\", \"quarto\", \"voz\"], \"crepúsculo\": [\"ano\", \"aurora\", \"cunhado\", \"gíria\", \"hoje\", \"ontem\", \"segundo\", \"época\"], \"cunhado\": [\"crepúsculo\", \"pais\", \"sobrinho\", \"sogra\"], \"dança\": [\"desenho\", \"piano\", \"rima\", \"tambor\", \"teatro\", \"voz\"], \"dedo\": [\"mão\", \"palavra\", \"pé\", \"sapateiro\", \"unha\"], \"dente\": [\"alma\", \"chá\", \"hoje\", \"língua\", \"pescoço\", \"pulmão\", \"sogra\"], \"des\n[... 41182 chars cut by the benchmark]\n\n--- tmp/t.html ---\n<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><title>Universo de palavras</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@400;700&display=swap\" rel=\"stylesheet\">\n<style>body{margin:0;background:#0d0f1a;color:#e8e4d8;font-family:Fraunces,Georgia,serif;overflow:hidden}\n#ui{position:fixed;top:16px;left:16px;width:300px;background:#161a2bdd;padding:14px;border-radius:10px;max-height:90vh;overflow:auto}\ninput{width:100%;box-sizing:border-box;padding:8px;font:inherit;background:#0d0f1a;color:#fff;border:1px solid #445;border-radius:6px}\nh1{font-size:20px;margin:0 0 4px}small{color:#99a}a{color:#ffd27a;cursor:pointer;text-decoration:none;margin-right:8px;display:inline-block}\n.an{color:#7ac7ff}</style></head><body><canvas id=\"c\"></canvas>\n<div id=\"ui\"><h1>Universo de palavras</h1><small id=\"st\"></small><input id=\"q\" list=\"dl\" placeholder=\"buscar palavra (ex.: saudade)\"><datalist id=\"dl\"></datalist><div id=\"info\"></div>\n<small>Amarelo = sinônimo, azul = análoga. Clique numa estrela.</small></div>\n<script>\nconst G=__DATA__;const W=G.w,names=Object.keys(W);const idx={};names.forEach((n,i)=>idx[n]=i);\nconst N=names.map((n,i)=>({n,d:W[n].length,x:Math.cos(i)*300*Math.random(),y:Math.sin(i)*300*Math.random(),vx:0,vy:0}));\nconst E=G.p.map(([a,b,s])=>({a:idx[a],b:idx[b],syn:s.includes('sinonimos')}));\nconst rel={};G.p.forEach(([a,b,s])=>{rel[a+'|'+b]=rel[b+'|'+a]=s});\ndocument.getElementById('st').textContent=names.length+' palavras, '+E.length+' relações';\ndl.innerHTML=names.map(n=>'<option value=\"'+n+'\">').join('');\nconst c=document.getElementById('c'),x=c.getContext('2d');let sel=null,cam={x:0,y:0,k:1};\nfunction rs(){c.width=innerWidth;c.height=innerHeight}rs();onresize=rs;\nfor(let it=0;it<400;it++)step(1-it/400);\nfunction step(t){for(const a of N)for(const b of N){if(a===b)continue;let dx=a.x-b.x,dy=a.y-b.y,d=dx*dx+dy*dy+1;let f=900/d;a.vx+=dx*f*t;a.vy+=dy*f*t}\nfor(const e of E){const a=N[e.a],b=N[e.b];let dx=b.x-a.x,dy=b.y-a.y;a.vx+=dx*.01;a.vy+=dy*.01;b.vx-=dx*.01;b.vy-=dy*.01}\nfor(const n of N){n.vx-=n.x*.002;n.vy-=n.y*.002;n.x+=n.vx*.5;n.y+=n.vy*.5;n.vx*=.6;n.vy*=.6}}\nconst P=n=>[(n.x-cam.x)*cam.k+c.width/2+150,(n.y-cam.y)*cam.k+c.height/2];\nfunction draw(){x.clearRect(0,0,c.width,c.height);const nb=sel!=null?new Set(W[names[sel]].map(w=>idx[w])):null;\nfor(const e of E){const on=sel!=null&&(e.a==sel||e.b==sel);x.strokeStyle=on?(e.syn?'#ffd27a':'#7ac7ff'):(sel!=null?'#ffffff08':'#ffffff18');x.lineWidth=on?2:1;const[p,q]=[P(N[e.a]),P(N[e.b])];x.beginPath();x.moveTo(...p);x.lineTo(...q);x.stroke()}\nN.forEach((n,i)=>{const[px,py]=P(n),hi=sel==i||(nb&&nb.has(i));const r=2+Math.sqrt(n.d)*1.3;x.fillStyle=sel==i?'#fff':hi?'#ffd27a':sel!=null?'#556':'#c9c3e8';x.beginPath();x.arc(px,py,r,0,7);x.fill();\nif(hi||n.d>=10||cam.k>1.8){x.fillStyle=hi?'#fff':'#aab';x.font=(sel==i?18:12)+'px Fraunces';x.fillText(n.n,px+r+3,py+4)}})}\nfunction pick(w){w=(w||'').trim().toLowerCase();if(!(w in idx)){info.innerHTML=w?'<p>“'+w+'” não está no dicionário.</p>':'';sel=null;draw();return}\nsel=idx[w];const n=N[sel];cam.x=n.x;cam.y=n.y;cam.k=1.6;history.replaceState(null,'','?word='+encodeURIComponent(w));q.value=w;\ninfo.innerHTML='<h1>'+w+'</h1><small>'+W[w].length+' ligações</small><p>'+W[w].map(v=>'<a class=\"'+(rel[w+'|'+v].includes('sinonimos')?'':'an')+'\" data-w=\"'+v+'\">'+v+'</a>').join(' ')+'</p>';draw()}\ninfo.onclick=e=>{if(e.target.dataset.w)pick(e.target.dataset.w)};q.onchange=()=>pick(q.value);\nc.onclick=e=>{let best=null,bd=200;N.forEach((n,i)=>{const[px,py]=P(n),d=(px-e.clientX)**2+(py-e.clientY)**2;if(d<bd){bd=d;best=i}});best!=null?pick(names[best]):(sel=null,cam.k=1,info.innerHTML='',draw())};\nc.onwheel=e=>{cam.k*=e.deltaY<0?1.1:.9;draw()};let dr=null;c.onmousedown=e=>dr=[e.clientX,e.clientY];onmouseup=()=>dr=null;\nc.onmousemove=e=>{if(!dr||!e.buttons)return;cam.x-=(e.clientX-dr[0])/cam.k;cam.y-=(e.clientY-dr[1])/cam.k;dr=[e.clientX,e.clientY];draw()};\nconst w0=new URLSearchParams(location.search).get('word\n[... 64 chars cut by the benchmark]\n\n--- tmp/x.py ---\nimport re,os,json,sys,unicodedata\r\nd=sys.argv[1];h1={};links={};miss=set();sec=set();red={}\r\nfor f in os.listdir(d):\r\n    t=open(os.path.join(d,f),encoding='utf-8',errors='replace').read()\r\n    m=re.search(r'<h1>(.*?)</h1>',t)\r\n    r=re.search(r'url=([^\"]+)\"',t)\r\n    if not m:\r\n        if r: red[f.lower()]=r.group(1).lower()\r\n        continue\r\n    h1[f.lower()]=m.group(1).strip().lower()\r\n    main=re.search(r'<main>(.*?)</main>',t,re.S)\r\n    links[f.lower()]=[]\r\n    for s,body in re.findall(r'<section id=\"(\\w+)\">(.*?)</section>',main.group(1) if main else '',re.S):\r\n        sec.add(s)\r\n        for href,txt in re.findall(r'href=\"([^\"]+)\">(.*?)</a>',body):\r\n            links[f.lower()].append((href.lower(),txt.strip().lower(),s))\r\nW={};P={}\r\nfor f,ls in links.items():\r\n    a=h1[f];W.setdefault(a,set())\r\n    for href,txt,s in ls:\r\n        import urllib.parse as u\r\n        hk=unicodedata.normalize('NFKD',u.unquote(href)).encode('ascii','ignore').decode()\r\n        href=red.get(href,href);b=h1.get(href) or h1.get(u.unquote(href)) or h1.get(hk)\r\n        if b is None: miss.add((href,txt)); continue\r\n        if b==a: continue\r\n        W[a].add(b);W.setdefault(b,set()).add(a)\r\n        k=tuple(sorted((a,b)));P.setdefault(k,set()).add(s)\r\nwords={k:sorted(v) for k,v in sorted(W.items())}\r\nmc=max(words,key=lambda k:len(words[k]))\r\njson.dump(words,open('words.json','w',encoding='utf-8'),ensure_ascii=False,indent=1)\r\njson.dump({'words':len(words),'relations':len(P),'most_connected':mc},open('result.json','w',encoding='utf-8'),ensure_ascii=False)\r\njson.dump({'w':words,'p':[[a,b,sorted(s)] for (a,b),s in P.items()]},open('tmp/g.json','w',encoding='utf-8'),ensure_ascii=False)\r\nprint(sec,len(h1),'missing',sorted(miss)[:20],mc,len(words[mc]))\r\n\n\n--- universe/index.html ---\n<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><title>Universo de palavras</title>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@400;700&display=swap\" rel=\"stylesheet\">\r\n<style>body{margin:0;background:#0d0f1a;color:#e8e4d8;font-family:Fraunces,Georgia,serif;overflow:hidden}\r\n#ui{position:fixed;top:16px;left:16px;width:300px;background:#161a2bdd;padding:14px;border-radius:10px;max-height:90vh;overflow:auto}\r\ninput{width:100%;box-sizing:border-box;padding:8px;font:inherit;background:#0d0f1a;color:#fff;border:1px solid #445;border-radius:6px}\r\nh1{font-size:20px;margin:0 0 4px}small{color:#99a}a{color:#ffd27a;cursor:pointer;text-decoration:none;margin-right:8px;display:inline-block}\r\n.an{color:#7ac7ff}</style></head><body><canvas id=\"c\"></canvas>\r\n<div id=\"ui\"><h1>Universo de palavras</h1><small id=\"st\"></small><input id=\"q\" list=\"dl\" placeholder=\"buscar palavra (ex.: saudade)