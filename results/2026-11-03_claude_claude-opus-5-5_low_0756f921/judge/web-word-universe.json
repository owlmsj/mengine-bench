"jardim\", \"milho\", \"onda\", \"ponte\", \"prado\", \"selva\"], \"canção\": [\"ator\", \"cena\", \"idioma\", \"melodia\", \"música\", \"pai\", \"tela\"], \"capital\": [\"aldeia\", \"cidade\", \"cozinha\", \"estação\", \"padeiro\", \"riacho\", \"tempo\", \"vila\", \"voz\"], \"carinho\": [\"afeto\", \"compaixão\", \"esperança\", \"melancolia\", \"prado\", \"saudade\", \"ternura\"], \"carne\": [\"almoço\", \"arroz\", \"filho\", \"mandioca\", \"nação\", \"ovo\", \"peixe\", \"salário\"], \"carpinteiro\": [\"ferreiro\", \"patrão\", \"pedreiro\", \"trabalho\", \"vila\"], \"casa\": [\"avenida\", \"dia\", \"escola\", \"igreja\", \"lar\", \"poesia\"], \"cena\": [\"ator\", \"canção\", \"livro\", \"melodia\", \"mãe\", \"ponte\", \"teatro\"], \"chá\": [\"arroz\", \"café\", \"dente\", \"peixe\", \"queijo\", \"vinho\"], \"cidade\": [\"capital\", \"estado\", \"estação\", \"jardim\", \"país\", \"prima\"], \"cinema\": [\"escultura\", \"fotografia\", \"pergunta\", \"tela\"], \"comida\": [\"farinha\", \"história\", \"peito\", \"refeição\", \"água\"], \"compaixão\": [\"angústia\", \"carinho\", \"contentamento\", \"esperança\", \"felicidade\", \"ovo\", \"sílaba\", \"ternura\"], \"contato\": [], \"contentamento\": [\"compaixão\", \"felicidade\", \"pais\", \"prazer\"], \"conto\": [\"folha\", \"herança\", \"lar\", \"livro\", \"paixão\", \"palavra\", \"romance\", \"verso\"], \"conversa\": [\"fala\", \"felicidade\", \"grito\", \"silêncio\"], \"coração\": [\"advogado\", \"jantar\", \"joelho\", \"peito\", \"rosto\"], \"corpo\": [\"alma\", \"cabeça\", \"peixe\", \"pescoço\"], \"cozinha\": [\"capital\", \"esquina\", \"fígado\", \"janela\", \"pai\", \"quarto\", \"voz\"], \"crepúsculo\": [\"ano\", \"aurora\", \"cunhado\", \"gíria\", \"hoje\", \"ontem\", \"segundo\", \"época\"], \"cunhado\": [\"crepúsculo\", \"pais\", \"sobrinho\", \"sogra\"], \"dança\": [\"desenho\", \"piano\", \"rima\", \"tambor\", \"teatro\", \"voz\"], \"dedo\": [\"mão\", \"palavra\", \"pé\", \"sapateiro\", \"unha\"], \"dente\"